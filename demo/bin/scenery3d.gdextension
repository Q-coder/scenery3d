[configuration]

entry_symbol = "scenery3d_library_init"
compatibility_minimum = "4.3"
reloadable = true

[libraries]

macos.debug = "res://bin/libscenery3d.macos.template_debug.double.arm64.dylib"
macos.release = "res://bin/libscenery3d.macos.template_release.double.arm64.dylib"
windows.debug.x86_32 = "res://bin/libscenery3d.windows.template_debug.x86_32.dll"
windows.release.x86_32 = "res://bin/libscenery3d.windows.template_release.x86_32.dll"
windows.debug.x86_64 = "res://bin/libscenery3d.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://bin/libscenery3d.windows.template_release.x86_64.dll"
linux.debug.x86_64 = "res://bin/libscenery3d.linux.template_debug.x86_64.so"
linux.release.x86_64 = "res://bin/libscenery3d.linux.template_release.x86_64.so"
linux.debug.arm64 = "res://bin/libscenery3d.linux.template_debug.arm64.so"
linux.release.arm64 = "res://bin/libscenery3d.linux.template_release.arm64.so"
