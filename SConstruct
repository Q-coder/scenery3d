
env = SConscript('godot-cpp/SConstruct')

# Paths
godot_headers_path = "godot-cpp/godot_headers/"
cpp_bindings_path = "godot-cpp/"

env.Append(CPPPATH="src/")
env.Append(CPPPATH="godot-cpp/include/")
env.Append(CPPPATH=['.', godot_headers_path, cpp_bindings_path + 'include/', cpp_bindings_path + 'include/core/', cpp_bindings_path + 'include/gen/'])
env.Append(LIBPATH=[cpp_bindings_path + 'bin/'])

# The shaders' source compiled into the library (src/s3d_shaders.cpp): an
# exported game has no file below this folder (.gdignore). One string literal
# per line keeps every literal far below MSVC's 16 kB limit.
def _write_embedded_shaders():
    import glob, os
    base = Dir('.').srcnode().abspath
    out = ['// Generated by the SConstruct from shaders/*.gdshader. Do not edit.',
           'struct S3DEmbeddedShader { const char *name; const char *code; };',
           'static const S3DEmbeddedShader S3D_EMBEDDED_SHADERS[] = {']
    files = sorted(glob.glob(os.path.join(base, 'shaders', '*.gdshader')))
    for f in files:
        name = os.path.splitext(os.path.basename(f))[0]
        out.append('\t{"%s",' % name)
        with open(f, encoding='utf-8') as fh:
            for line in fh.read().splitlines():
                esc = line.replace('\\', '\\\\').replace('"', '\\"')
                esc = ''.join(c if ord(c) < 128 else ''.join('\\%03o' % b for b in c.encode('utf-8')) for c in esc)
                out.append('\t\t"%s\\n"' % esc)
        out.append('\t},')
    out.append('};')
    out.append('static const int S3D_EMBEDDED_SHADER_COUNT = %d;' % len(files))
    text = '\n'.join(out) + '\n'
    target = os.path.join(base, 'src', 's3d_shaders_gen.h')
    old = None
    if os.path.exists(target):
        with open(target, encoding='utf-8') as fh:
            old = fh.read()
    if old != text:
        with open(target, 'w', encoding='utf-8', newline='\n') as fh:
            fh.write(text)

_write_embedded_shaders()

src = Glob("src/*.cpp")

libpath = 'demo/bin/libscenery3d{}{}'.format(env['suffix'], env['SHLIBSUFFIX'])
sharedlib = env.SharedLibrary(libpath, src)
Default(sharedlib)
